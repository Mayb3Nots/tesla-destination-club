rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chargers — readable by anyone (public page), writable only via cloud function
    match /chargers/{chargerId} {
      allow read: if true;

      // Bookings subcollection
      match /bookings/{bookingId} {
        // Anyone can read bookings (needed for public availability display)
        allow read: if true;

        // Create/update denied from client — must use cloud function
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // Vehicles — users can manage their own vehicles
    match /vehicles/{vehicleId} {
      allow get: if request.auth != null && request.auth.uid == resource.data.userId;
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Users — users can read/write their own profile (fcmToken, notification preferences)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Hogging Reports — authenticated users can submit reports
    match /hoggingReports/{reportId} {
      // Authenticated users can create reports
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reportedByUserId;
      
      // Report authors and admins can read their own/all reports
      allow read: if request.auth != null && 
                     (request.auth.uid == resource.data.reportedByUserId || 
                      request.auth.token.isAdmin == true ||
                      resource.data.status == 'approved');
      
      // Only admins can update (approve/reject reports)
      allow update: if request.auth != null && request.auth.token.isAdmin == true;
      
      allow delete: if false;
    }

    // Hoggers Leaderboard — readable by anyone (public), writable only via cloud function
    match /hoggers/{plateNumber} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
