rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chargers — readable by anyone (public page), writable only via cloud function
    match /chargers/{chargerId} {
      allow read: if true;

      // Bookings subcollection
      match /bookings/{bookingId} {
        // Anyone can read bookings (needed for public availability display)
        allow read: if true;

        // Create/update denied from client — must use cloud function
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // Vehicles — users can manage their own vehicles
    match /vehicles/{vehicleId} {
      allow get: if request.auth != null && request.auth.uid == resource.data.userId;
      allow list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Users — users can read/write their own profile (fcmToken, notification preferences)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
