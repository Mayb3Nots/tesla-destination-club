rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chargers — readable by all authenticated users, writable only via cloud function
    match /chargers/{chargerId} {
      allow read: if request.auth != null;

      // Bookings subcollection
      match /bookings/{bookingId} {
        // Anyone authenticated can read bookings (needed for queue display)
        allow read: if request.auth != null;

        // Create/update denied from client — must use cloud function
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }
    }

    // Vehicles — users can manage their own vehicles
    match /vehicles/{vehicleId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
      allow list: if request.auth != null;
    }
  }
}
